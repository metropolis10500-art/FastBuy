# ============================================================
#  ДругоКэш — настройки бота
#  Заполните BOT_TOKEN и ADMIN_IDS, остальное можно оставить
# ============================================================

# --- ОБЯЗАТЕЛЬНО ---
# Токен от @BotFather
BOT_TOKEN=9291057303:AAHQYZK22NkVMS0XcH1VSgsXTso8yqiWTGI
# Ваш Telegram ID (числом), можно несколько через запятую. Узнать: @userinfobot
ADMIN_IDS=9247170451

# --- НАЗВАНИЕ БОТА (для текстов/платежей) ---
BOT_NAME=ДругоКэш

# --- ПОДДЕРЖКА (ваша личная ссылка, к названию бота не привязана) ---
SUPPORT_URL=https://t.me/vladofix97
SUPPORT_USERNAME=@vladofix97

# --- ЦЕНЫ ЗА ДРУЗЕЙ, ₽ (1 / 2 / 3 уровень) ---
REF_L1=12
REF_L2=7
REF_L3=3

# --- ЕЖЕДНЕВНЫЙ БОНУС ---
BONUS_AMOUNT=25
BONUS_COOLDOWN_HOURS=24

# --- ВЫВОД СРЕДСТВ ---
MIN_WITHDRAW=3000
WITHDRAW_COMMISSION_PERCENT=0

# --- РЕКЛАМА ---
AD_PRICE=5000
AD_DURATION_HOURS=72
# Канал/чат, куда бот публикует рекламу и откуда удаляет её через 72 ч.
# Бот должен быть админом канала. Пример: @my_channel или -1001234567890
AD_CHANNEL_ID=
AD_MAX_TEXT=900

# --- ЮMONEY ---
# Номер кошелька, на который принимаем оплату (для пополнения баланса)
YOOMONEY_WALLET=4100118935779591
# Токен из https://yoomoney.ru/transfer/myservices/http-notification (или api токен)
YOOMONEY_TOKEN=8BE176DEFDE0ED619164EB32845C863D58EDF5A49E9B0416A90FCEE9D298D24D
# Получатель для формы оплаты (обычно = YOOMONEY_WALLET)
YOOMONEY_RECEIVER=
# Автовыплата на кошельки ЮMoney (p2p). Требует токен с правами платежей.
YOOMONEY_AUTOPAYOUT=false
YOOMONEY_POLL_SECONDS=30

# --- ПОПОЛНЕНИЕ БАЛАНСА ---
TOPUP_MIN=500
TOPUP_MAX=50000

# --- ПРОЧЕЕ ---
DB_PATH=data/bot.db
LOG_LEVEL=INFO
# Часовой пояс для дат (Москва = 3)
TZ_OFFSET=3
# 0 = не уведомлять админов о всплесках рефералов, 10 = уведомлять при 10 друзьях/час
REF_ALERT_PER_HOUR=0
